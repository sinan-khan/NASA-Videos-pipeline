# Copy to `.env` and fill in for LOCAL runs.
# GitHub Actions gets the same values from repository Secrets instead.

# --- LLM (script writing) ------------------------------------------------
# Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Imagery -------------------------------------------------------------
# Free key at https://api.nasa.gov (works even without one via DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# --- YouTube --------------------------------------------------------------
# From the one-time auth script:  python scripts/oauth_local.py
YT_CLIENT_ID=your-oauth-client-id
YT_CLIENT_SECRET=your-oauth-client-secret
YT_REFRESH_TOKEN=your-refresh-token
# private | unlisted | public   (start private, flip to public when ready)
YT_PRIVACY_STATUS=private
YT_LANGUAGE=en
YT_CATEGORY_ID=28

# --- Video ---------------------------------------------------------------
# Optional: voice override, e.g. en-US-ChristopherNeural
# VIDEO_VOICE=en-US-ChristopherNeural
# Optional: direct link to a royalty-free music track
# MUSIC_URL=https://example.com/ambient.mp3
# MUSIC_VOLUME=0.08

# --- Behaviour -------------------------------------------------------------
# 1 to build the video without uploading (great for first local test)
DRY_RUN=0
# 1 to skip regeneration and re-upload the last built video
UPLOAD_ONLY=0
# 1 to keep intermediate files for debugging
KEEP_ARTIFACTS=0
LOG_LEVEL=INFO
